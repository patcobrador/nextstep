{
  "name": "nextstep",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:infra": "docker compose up -d postgres minio",
    "deploy:local": "docker compose up -d --build api web",
    "deploy:status": "docker compose ps",
    "demo:checkpoint-a": "corepack pnpm --filter @nextstep/api demo:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "test:authz": "turbo run test:authz",
    "test:security": "turbo run test:security",
    "test:a11y": "turbo run test:a11y",
    "test:e2e:walking-skeleton": "turbo run test:e2e:walking-skeleton",
    "test:e2e:checkpoint-a": "corepack pnpm --filter @nextstep/web test:e2e:checkpoint-a",
    "test:visual:checkpoint-a": "corepack pnpm --filter @nextstep/web test:visual:checkpoint-a",
    "contracts:lint": "corepack pnpm --filter @nextstep/contracts lint:openapi",
    "contracts:generate": "corepack pnpm --filter @nextstep/contracts generate",
    "contracts:check-generated": "corepack pnpm --filter @nextstep/contracts check:generated",
    "curriculum:validate": "corepack pnpm --filter @nextstep/curriculum-sdk validate:seed",
    "prisma:format": "corepack pnpm --filter @nextstep/database prisma:format",
    "prisma:validate": "corepack pnpm --filter @nextstep/database prisma:validate",
    "prisma:migrate:diff": "corepack pnpm --filter @nextstep/database prisma:migrate:diff",
    "prisma:migrate:deploy": "corepack pnpm --filter @nextstep/database prisma:migrate:deploy",
    "test:migrations": "corepack pnpm --filter @nextstep/database test:migrations"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "eslint": "10.8.0",
    "pnpm": "11.18.0",
    "prettier": "3.6.2",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
