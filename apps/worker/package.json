{
  "name": "@nextstep/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run .integration.test.ts --passWithNoTests",
    "test:contract": "vitest run --exclude \"**/*.integration.test.ts\" --passWithNoTests",
    "test:authz": "vitest run --exclude \"**/*.integration.test.ts\" --passWithNoTests",
    "test:security": "vitest run --exclude \"**/*.integration.test.ts\" --passWithNoTests",
    "test:a11y": "vitest run --exclude \"**/*.integration.test.ts\" --passWithNoTests",
    "test:e2e:walking-skeleton": "vitest run --exclude \"**/*.integration.test.ts\" --passWithNoTests"
  },
  "dependencies": {
    "@nextstep/database": "workspace:*",
    "@nextstep/domain": "workspace:*",
    "@nextstep/media": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "vitest": "4.1.10"
  }
}
