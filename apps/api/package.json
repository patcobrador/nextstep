{
  "name": "@nextstep/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "demo:seed": "tsx src/checkpoint-a.seed.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run",
    "test:contract": "vitest run --passWithNoTests",
    "test:authz": "vitest run -t authorisation",
    "test:security": "vitest run -t authorisation",
    "test:a11y": "vitest run --passWithNoTests",
    "test:e2e:walking-skeleton": "vitest run src/walking-skeleton.e2e.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nextstep/database": "workspace:*",
    "@nextstep/contracts": "workspace:*",
    "@nextstep/domain": "workspace:*",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
