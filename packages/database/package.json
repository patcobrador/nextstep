{
  "name": "@nextstep/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --config prisma.config.ts && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('src/generated',{recursive:true,force:true})\"",
    "lint": "prisma validate --config prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate:diff": "prisma migrate diff --config prisma.config.ts --from-empty --to-schema prisma/schema.prisma --script",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:contract": "vitest run --passWithNoTests",
    "test:authz": "vitest run --passWithNoTests",
    "test:security": "vitest run --passWithNoTests",
    "test:a11y": "vitest run --passWithNoTests",
    "test:e2e:walking-skeleton": "vitest run --passWithNoTests",
    "test:migrations": "prisma validate --config prisma.config.ts && prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
